/*
 * Copy to wifi_secrets.h and fill in. That file is gitignored — the same
 * arrangement as the dongle's igate_secrets.h.
 *
 * The credentials matter for one reason: ESP-NOW rides the channel the station
 * is on, so associating to the SAME access point as the other device is what
 * puts both on the same channel without anybody guessing. Leave the SSID empty
 * to stay unassociated and use ESPNOW_FALLBACK_CHANNEL instead — which only
 * ever meets another unassociated board.
 */
#define WIFI_SSID ""
#define WIFI_PASS ""

/* Used only when WIFI_SSID is empty. */
#define ESPNOW_FALLBACK_CHANNEL 1

/*
 * Copy to `wifi_secrets.h` and fill in. That filename is gitignored.
 *
 * Only the operator's own station needs this. It is the fallback used when no
 * credentials have been saved through the captive portal or the `wifi_connect`
 * console command -- it lets a freshly flashed dongle reach APRS-IS without
 * anyone standing over it. Leave the file absent and the station waits for the
 * captive portal instead, which is what you want on anybody else's hardware.
 *
 * The same two names are used by the m5stack and espnow_probe projects, so one
 * filled-in copy can serve all three.
 */
#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"
